# Copy as .env only for Docker Compose interpolation; never give this file to
# the collector. Use URL-encoded passwords in connection URLs.
POSTGRES_PASSWORD=
LEADS_DB_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_MAINTENANCE_DB_PASSWORD=
LEADS_DATABASE_URL=postgresql://farpoint_leads:REPLACE@postgres:5432/farpoint_leads?sslmode=disable
UMAMI_DATABASE_URL=postgresql://umami:REPLACE@postgres:5432/umami?sslmode=disable
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=
