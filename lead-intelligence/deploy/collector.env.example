# Copy into the host's secret settings, or .env.collector for Compose.
# Examples are deliberately nonfunctional. Never commit filled-in values.
NODE_ENV=production
DATABASE_URL=postgresql://farpoint_leads:REPLACE@postgres:5432/farpoint_leads?sslmode=disable
PORT=8080
COLLECTOR_PUBLIC_URL=
ALLOWED_ORIGINS=https://farpointenergy.com,https://www.farpointenergy.com
ADMIN_TOKEN=
NETWORK_HMAC_KEY=
DELETION_HMAC_KEY=
UMAMI_URL=http://umami:3000
UMAMI_WEBSITE_ID=
UMAMI_QA_WEBSITE_ID=
QA_ENVIRONMENT=false
TRUST_PROXY_MODE=disabled
PROXY_TRUST_VERIFIED=false
TRUSTED_PROXY_CIDRS=
ENRICHMENT_ENABLED=false
IPAPI_KEY=
CAMPAIGNS_JSON={}
TARGET_ACCOUNTS_JSON={}
GMAIL_MAILBOX=karan@farpointenergy.com
REPORT_RECIPIENT=karan@farpointenergy.com
REPORT_CADENCES=weekly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
